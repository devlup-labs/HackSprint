# API Gateway base URL. The frontend never talks to individual microservices
# (user-service, admin-service, hackathon-service, media-service, notification-service)
# directly — every request goes through this single gateway origin, using
# the same /api/... endpoint paths in both environments.
#
# Vite inlines this at BUILD time, not runtime — rebuild after changing it.

# Development (local API gateway + nginx, or gateway run directly on :5000)
VITE_API_URL=http://localhost:5000

# Production
# VITE_API_URL=https://rahul1901.prometeo.in

# Google OAuth web client id (login, signup and One Tap). The client must list
# this site's origin under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
