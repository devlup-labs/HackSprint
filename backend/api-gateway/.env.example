NODE_ENV=development
PORT=5000
FRONTEND_URL=YOUR_URL
USER_SERVICE_URL=YOUR_URL
HACKATHON_SERVICE_URL=YOUR_URL
ADMIN_SERVICE_URL=YOUR_URL
MEDIA_SERVICE_URL=YOUR_URL
NOTIFICATION_SERVICE_URL=YOUR_URL
CHATBOT_SERVICE_URL=YOUR_URL

# Token check + shared rate limits. SECRET_KEY and INTERNAL_SERVICE_SECRET must
# match the services'; leave them unset and services verify tokens themselves.
# REDIS_URL unset = rate-limit counters are per-process.
SECRET_KEY=
INTERNAL_SERVICE_SECRET=
REDIS_URL=

# Error monitoring (optional) — leave unset to disable
SENTRY_DSN=
